# Copy this file to .env and fill in your values

# ── FPL login (also works with Google login) ─────────────────────────────────
# How to get PL_COOKIE_HEADER:
#   1. Go to https://draft.premierleague.com and log in
#   2. Open DevTools (F12) → the Network tab
#   3. Reload the page, find a request to "api/game" or "api/element-status"
#   4. Under Request Headers, copy the entire value of the "Cookie" header
PL_COOKIE_HEADER=paste_the_entire_cookie_header_here

# Your team ID (found as "activeEntry" in the cookie, or in the URL on the "My Team" page)
PL_ENTRY_ID=123456

# ── Website login (app.py only) ───────────────────────────────────────────────
# Password required to view the website. Pick your own value.
APP_PASSWORD=choose_a_password

# Random key used to sign the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must stay the same across restarts/deploys, or you'll get logged out every time.
SECRET_KEY=generate_a_random_value_here
