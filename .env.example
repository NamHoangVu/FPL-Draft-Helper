# Kopier denne filen til .env og fyll inn verdiene dine

# ── FPL-innlogging (fungerer med Google-innlogging også) ─────────────────────
# Slik henter du PL_COOKIE_HEADER:
#   1. Gå til https://draft.premierleague.com og logg inn
#   2. Åpne DevTools (F12) → fanen Network
#   3. Last siden på nytt, finn en forespørsel til "api/game" eller "api/element-status"
#   4. Under Request Headers, kopier hele verdien av "Cookie"-headeren
PL_COOKIE_HEADER=lim_inn_hele_cookie_headeren_her

# Lag-ID-en din (finnes som "activeEntry" i cookien, eller i URL på "My Team"-siden)
PL_ENTRY_ID=123456
